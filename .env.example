# Copy this file to  .env  and fill in the passwords. No quotes needed.
# Put .env ONE FOLDER ABOVE public_html if you can (safest), or next to index.html.

SALES_USER=sales@mahindo.in
SALES_PASS=PUT_SALES_MAILBOX_PASSWORD_HERE
SALES_TO=sales@mahindo.in

HR_USER=hr@mahindo.in
HR_PASS=PUT_HR_MAILBOX_PASSWORD_HERE
HR_TO=hr@mahindo.in

# Hostinger defaults (change only if 465 is blocked: use 587 + tls)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl

# Any long random text; only used by smtp-test.php (delete that file after testing)
TEST_KEY=
